{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string",
      "title": "Sale / Invoice number"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer name"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer phone"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "title": "Sale date"
    },
    "total_amount": {
      "type": "number",
      "title": "Total amount",
      "default": 0
    },
    "item_count": {
      "type": "number",
      "title": "Number of items",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "sale_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}