{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "title": "Supplier ID"
    },
    "supplier_name": {
      "type": "string",
      "title": "Supplier name"
    },
    "bill_number": {
      "type": "string",
      "title": "Bill number"
    },
    "bill_image_uri": {
      "type": "string",
      "title": "Uploaded bill file URI"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "title": "Purchase date"
    },
    "total_amount": {
      "type": "number",
      "title": "Total amount",
      "default": 0
    },
    "item_count": {
      "type": "number",
      "title": "Number of items",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "confirmed",
        "pending"
      ],
      "default": "confirmed"
    }
  },
  "required": [
    "purchase_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}